import asyncio
import os
import struct
import oqs
from cryptography.hazmat.primitives.asymmetric import x25519
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.kdf.hkdf import HKDF
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

# Generate Server Identity Long-Term Key Pairs properly using liboqs API
with oqs.KeyEncapsulation("ML-KEM-1024") as kem:
    KEM_PUB = kem.generate_keypair()
    KEM_PRIV = kem.export_secret_key()
X_PRIV_OBJ = x25519.X25519PrivateKey.generate()
X_PUB = X_PRIV_OBJ.public_key().public_bytes_raw()

with open("server_kem.pub", "wb") as f: f.write(KEM_PUB)
with open("server_x25519.pub", "wb") as f: f.write(X_PUB)

def server_hybrid_decap(kem_ciphertext, client_x_pub):
    # FIXED: Pass secret_key parameter directly into the constructor to avoid ctypes corruption
    with oqs.KeyEncapsulation("ML-KEM-1024", secret_key=KEM_PRIV) as kem:
        kem_shared = kem.decap_secret(kem_ciphertext)
    cli_pub_obj = x25519.X25519PublicKey.from_public_bytes(client_x_pub)
    x25519_shared = X_PRIV_OBJ.exchange(cli_pub_obj)
    combined = kem_shared + x25519_shared
    return HKDF(algorithm=hashes.SHA3_512(), length=32, salt=None, info=b"Z-Protocol Derivation").derive(combined)

def decrypt_payload(key, encrypted_blob):
    aesgcm = AESGCM(key)
    return aesgcm.decrypt(encrypted_blob[:12], encrypted_blob[12:], None)

def encrypt_payload(key, plaintext):
    aesgcm = AESGCM(key)
    nonce = os.urandom(12)
    return nonce + aesgcm.encrypt(nonce, plaintext, None)

class ZServerUDPProtocol(asyncio.DatagramProtocol):
    def connection_made(self, transport):
        self.transport = transport

    def datagram_received(self, data, addr):
        asyncio.create_task(self.process_packet(data, addr))

    async def process_packet(self, data, addr):
        header_size = struct.calcsize("!2sB8s1568s32sI")
        if len(data) < header_size: return

        header_data = data[:header_size]
        magic, msg_type, session_id, _, client_x_pub, _ = struct.unpack("!2sB8s1568s32sI", header_data)
        
        if magic != b"ZP": return

        payload = data[header_size:]
        kem_ciphertext = payload[:1568]
        encrypted_http_request = payload[1568:]

        print(f"\n[Z-Tunnel Ingress] Intercepted 0-RTT frame from {addr}")
        
        try:
            session_key = server_hybrid_decap(kem_ciphertext, client_x_pub)
            browser_http_request = decrypt_payload(session_key, encrypted_http_request)

            lines = browser_http_request.decode(errors='ignore').split("\r\n")
            print(f"🎨 Browser Request Routed: {lines[0] if lines else 'Unknown'}")

            # Forward request locally to your running target backend HTML server (Port 8080)
            try:
                backend_reader, backend_writer = await asyncio.open_connection("127.0.0.1", 8080)
                backend_writer.write(browser_http_request)
                await backend_writer.drain()

                backend_response = b""
                while True:
                    chunk = await backend_reader.read(4096)
                    backend_response += chunk
                    if len(chunk) < 4096: break
                backend_writer.close()
            except Exception:
                backend_response = b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 32\r\n\r\nProxy local backend offline."

            encrypted_response = encrypt_payload(session_key, backend_response)
            self.transport.sendto(encrypted_response, addr)
            print(f"[Z-Tunnel Egress] Returned encrypted website payload to client proxy.")
        except Exception as e:
            print(f"[-] Decryption error or pipeline crash: {e}")

async def main():
    print("[*] Launching Core Post-Quantum Server Proxy Gateway...")
    loop = asyncio.get_running_loop()
    transport, protocol = await loop.create_datagram_endpoint(ZServerUDPProtocol, local_addr=("127.0.0.1", 9000))
    await asyncio.Event().wait()

if __name__ == "__main__":
    asyncio.run(main())
